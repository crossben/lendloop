# Convex deployment environment — set these with `npx convex env set`.
# Copy to convex/.env only if you use a script that loads it; never commit it.

# Clerk JWT issuer domain. Clerk dashboard → Configure → JWT templates →
# create a template named "convex" (aud: "convex"), then copy the issuer URL,
# e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Comma-separated emails that are promoted to admin on sign-in.
# Never auto-demotes an existing admin.
ADMIN_EMAILS=admin@example.com

# Shared HMAC secret. Must match LENDLOOP_HMAC_SECRET in n8n/.env.
# Generate with: openssl rand -hex 32
N8N_HMAC_SECRET=replace-with-openssl-rand-hex-32

# n8n production webhook URL for loan events.
# Local: http://localhost:5678/webhook/lendloop/loan-events
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/loan-events
