# Copy this file to n8n/.env before running `docker compose up`.
# Never commit n8n/.env.

# Stable key n8n uses to encrypt stored credentials. Generate once and keep it:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Shared secret for HMAC-SHA256 in both directions. Must be identical to
# N8N_HMAC_SECRET on the Convex deployment. Generate with:
#   openssl rand -hex 32
LENDLOOP_HMAC_SECRET=replace-with-openssl-rand-hex-32

# Base URL of the Convex deployment's HTTP actions, without a trailing slash.
# - Local Convex from inside Docker (Linux/macOS/Windows Docker Desktop):
#   The local backend serves HTTP actions on port 3211 (the API is on 3210).
LENDLOOP_CONVEX_URL=http://host.docker.internal:3211
# - Convex cloud:
# LENDLOOP_CONVEX_URL=https://your-deployment.convex.site

# Public origin n8n uses when registering production webhooks and editor links.
# Local default:
WEBHOOK_URL=http://localhost:5678/
# When n8n sits behind a proxy or tunnel, use the public HTTPS origin instead:
# WEBHOOK_URL=https://n8n.example.com/
# N8N_EDITOR_BASE_URL=https://n8n.example.com/

# The n8n editor has its own user management. Do not expose port 5678 to the
# public internet without HTTPS and an authenticating reverse proxy / SSO.
