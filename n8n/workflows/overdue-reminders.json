{
  "id": "LLoverdueDaily01",
  "name": "LendLoop — Daily overdue reminders",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Daily at 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// GET with an empty canonical body: HMAC(timestamp + \".\" + \"\").\nconst crypto = require('crypto');\nconst baseUrl = String($env.LENDLOOP_CONVEX_URL || '').replace(/\\/$/, '');\nconst secret = $env.LENDLOOP_HMAC_SECRET;\n\nif (!baseUrl) throw new Error('LENDLOOP_CONVEX_URL is not configured');\nif (!secret) throw new Error('LENDLOOP_HMAC_SECRET is not configured');\n\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(`${timestamp}.`)\n  .digest('hex');\n\nreturn [{ json: { url: `${baseUrl}/n8n/overdue`, timestamp, signature } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Sign overdue feed request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        },
        "method": "GET"
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b2000000-0000-4000-8000-000000000004-condition",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Any overdue loans?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst reminderDate = response.reminderDate;\nconst loans = Array.isArray(response.loans) ? response.loans : [];\n\nreturn loans.map((loan) => ({\n  json: {\n    reminderDate,\n    loanId: loan.loanId,\n    toolName: loan.toolName,\n    startDate: loan.startDate,\n    endDate: loan.endDate,\n    daysOverdue: loan.daysOverdue,\n    borrowerFirstName: loan.borrowerFirstName,\n    borrowerEmail: loan.borrowerEmail,\n  },\n}));"
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Split loans",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once per overdue loan. Signs the exact JSON string that the HTTP node sends.\nconst crypto = require('crypto');\nconst baseUrl = String($env.LENDLOOP_CONVEX_URL || '').replace(/\\/$/, '');\nconst secret = $env.LENDLOOP_HMAC_SECRET;\n\nif (!baseUrl) throw new Error('LENDLOOP_CONVEX_URL is not configured');\nif (!secret) throw new Error('LENDLOOP_HMAC_SECRET is not configured');\n\nconst item = $json;\nconst body = JSON.stringify({\n  loanId: item.loanId,\n  reminderDate: item.reminderDate,\n  status: 'sent',\n  channel: 'n8n-log',\n  providerMessageId: `n8n-${item.loanId}-${item.reminderDate}`,\n});\n\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(`${timestamp}.${body}`)\n  .digest('hex');\n\nconsole.log(\n  `[LendLoop][reminder] ${item.toolName} is ${item.daysOverdue} day(s) overdue (${item.loanId})`,\n);\n\nreturn {\n  json: {\n    ...item,\n    url: `${baseUrl}/n8n/reminders`,\n    timestamp,\n    signature,\n    body,\n  },\n};"
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Sign reminder write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Record reminder in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "No overdue loans",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        100
      ]
    }
  ],
  "connections": {
    "Daily at 09:00 UTC": {
      "main": [
        [
          {
            "node": "Sign overdue feed request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue feed request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "Any overdue loans?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any overdue loans?": {
      "main": [
        [
          {
            "node": "Split loans",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split loans": {
      "main": [
        [
          {
            "node": "Sign reminder write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign reminder write-back": {
      "main": [
        [
          {
            "node": "Record reminder in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LLerrorHandler01",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "versionId": "LLoverdueVers001",
  "meta": {},
  "tags": [],
  "pinData": {}
}
